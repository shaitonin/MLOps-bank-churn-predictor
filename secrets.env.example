# Kaggle API credentials
# Required only for data ingestion (notebooks/ingestion_pipeline.py).
# Not needed for running the Streamlit app or FastAPI.
#
# How to get your credentials:
#   1. Go to https://www.kaggle.com/settings/account
#   2. Scroll to "API" and click "Create New Token"
#   3. Copy the username and key from the downloaded kaggle.json
#
# Copy this file to secrets.env and fill in your values:
#   cp secrets.env.example secrets.env

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
